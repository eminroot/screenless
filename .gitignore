# Belt and braces. Each of the three projects has its own .gitignore; this one
# repeats the dangerous entries at the root so a new folder added later cannot
# leak a secret by forgetting to bring an ignore file with it.

# Never. The Gemini dev key lives in one of these.
.env
.env.*
!.env.example

# Never. Losing the upload keystore means never updating the Play listing, and
# committing it means anyone can sign a build that claims to be ours.
credentials/
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision

# Regenerable, and enormous.
node_modules/
.expo/
dist/
web-build/
build/
.gradle/
.cxx/
.kotlin/

# Generated native projects. `expo prebuild` rebuilds them from app.json.
/screenless/android/
/screenless/ios/
/parent/android/
/parent/ios/

# The hub's database. One family's counters, and nobody else's business.
/server/data/

# Generated by the tooling, different on every machine.
expo-env.d.ts
*.tsbuildinfo
.metro-health-check*

# Noise
__pycache__/
*.pyc
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store

# A clone of somebody else's repo that happens to live here. It has its own
# origin, and committing it as a bare gitlink with no .gitmodules entry gives
# GitHub an unclickable grey folder that `git clone` never fetches.
/skills/

# Editor and agent workspace. Machine-specific launch configuration that
# belongs to whoever is sitting at the machine, not to the project.
.claude/
