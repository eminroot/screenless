rules_version = '2';

// The friends board database is written and read only by the leaderboard
// function, through the Admin SDK, which these rules do not apply to. No app,
// browser or script holding the Firebase web config gets in.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
