{
  "functions": [
    {
      "source": "functions",
      "codebase": "screenless-ai",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    },
    {
      "source": "leaderboard",
      "codebase": "screenless-social",
      "ignore": ["node_modules", ".git", "test", "dev-server.js", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "firestore": [
    {
      "database": "screenless",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "emulators": {
    "functions": { "port": 5001 },
    "firestore": { "port": 8085 },
    "ui": { "enabled": true }
  }
}
