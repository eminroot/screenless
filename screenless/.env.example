# Copy to .env for local development. .env is gitignored and never uploaded to EAS.

# Local development only. This value is inlined into the JS bundle, so treat any
# key you put here as public and use a restricted, low quota one. It is forced
# empty in release builds by the production profile in eas.json.
EXPO_PUBLIC_GEMINI_DEV_KEY=

# The only supported route for a published build. An https endpoint that holds
# the real key server side and forwards the request body unchanged.
# See server/gemini-proxy for one you can deploy in a few minutes.
EXPO_PUBLIC_GEMINI_PROXY_URL=

# The friends board server, only ever called for a child whose parent picked a
# username. Release builds accept https only. Development builds also accept
# http, for server/firebase/leaderboard/dev-server.js:
#   http://localhost:8787 in the browser, http://10.0.2.2:8787 on the Android emulator.
EXPO_PUBLIC_LEADERBOARD_URL=

# The parent dashboard hub, only ever called once a grown up has linked this
# phone with a six character code. With no url the whole feature is absent: no
# request is made and the app behaves exactly as it does without it.
# Release builds accept https only. Development builds also accept http, for
# a hub running on a laptop:
#   http://localhost:8099 in the browser, http://10.0.2.2:8099 on the Android
#   emulator (the rewrite is automatic, see src/sync/config.ts).
EXPO_PUBLIC_HUB_URL=
