{
  "name": "screenless",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/baloo-2": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-ml-kit/image-labeling": "^2.0.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.3.18",
    "expo": "~54.0.36",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-manipulator": "~14.0.8",
    "expo-keep-awake": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.24",
    "expo-sensors": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-speech": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "qrcode-generator": "^2.0.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "sucrase": "^3.35.0",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test:steps": "node -r sucrase/register scripts/tune-steps.ts",
    "test:walk": "node -r sucrase/register scripts/test-walk.ts",
    "test:social": "node -r sucrase/register scripts/test-social.ts",
    "test:board-server": "npm --prefix server/firebase/leaderboard test",
    "board:dev": "node server/firebase/leaderboard/dev-server.js --seed",
    "tune:steps": "node -r sucrase/register scripts/tune-steps.ts --sweep",
    "check:release": "node scripts/check-release.mjs",
    "preflight": "tsc --noEmit && expo export --platform android --output-dir dist && node scripts/check-release.mjs",
    "test:guard": "node -r sucrase/register scripts/test-guard.ts",
    "test:tasks": "node -r sucrase/register scripts/test-tasks.ts",
    "test:integrity": "node -r sucrase/register scripts/test-integrity.ts",
    "test:verify": "node -r sucrase/register scripts/test-verify.ts",
    "test:spark": "node -r sucrase/register scripts/test-spark.ts",
    "test:wardrobe": "node -r sucrase/register scripts/test-wardrobe.ts",
    "test:nudge": "node -r sucrase/register scripts/test-nudge.ts",
    "test:sync": "node -r sucrase/register scripts/test-sync.ts",
    "test:inbox": "node -r sucrase/register scripts/test-inbox.ts",
    "test:chat": "node -r sucrase/register scripts/test-chat.ts",
    "export:catalogue": "node -r sucrase/register scripts/export-catalogue.ts",
    "test:all": "node -r sucrase/register scripts/test-all.ts"
  },
  "private": true
}
